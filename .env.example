# Copy to .env and fill in. .env is gitignored -- never commit it.

# Signs login tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The first administrator, created only when the database has no users.
# Change the password after the first login.
ADMIN_EMAIL=admin@firm.local
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Port the office opens in a browser. 80 means plain http://<server-ip>/
WEB_PORT=80

# accounts = the CA test logins only (admin@test.com / staff@test.com, test123)
# true     = those logins plus two demo clients and sample workbooks
# false    = neither; one administrator from ADMIN_EMAIL/ADMIN_PASSWORD
# Keep this false on the office server.
SEED_DEMO=false
