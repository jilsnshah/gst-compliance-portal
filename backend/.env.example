# Copy to backend/.env and fill in. Never commit the real file.

# ---------------------------------------------------------------- storage
# "local" writes to ../storage on disk. "firebase" uses a Cloud Storage bucket.
STORAGE_BACKEND=local

# Firebase console -> Storage. Looks like my-project.appspot.com
# or my-project.firebasestorage.app on newer projects.
FIREBASE_BUCKET=

# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Save the JSON somewhere outside the repo and point at it.
FIREBASE_CREDENTIALS_FILE=/absolute/path/to/serviceAccountKey.json

# Serve downloads as short-lived signed URLs straight from the bucket instead
# of streaming the bytes through this API. Only applies to the firebase backend.
USE_SIGNED_URLS=false
SIGNED_URL_TTL_SECONDS=900

# ------------------------------------------------------------------- auth
# Dev-stage only. Replace before anything real touches this.
SECRET_KEY=dev-secret-not-for-production
